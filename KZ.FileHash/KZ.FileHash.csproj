<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Kareem Zein</Authors>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
	<Version>1.1.0</Version>
	<Title>KZ.FileHash</Title>
	<Description>A lightweight .NET library for calculating cryptographic hashes of files and streams asynchronously.</Description>
	<PackageTags>hash;hashing;cryptography;md5;sha1;sha256;sha384;sha512;sha3;sha3-256;sha3-384;sha3-512;file;stream;integrity;verification</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
	<RepositoryUrl>https://github.com/Kareem-Zein/KZ.FileHash</RepositoryUrl>
	<Copyright>Copyright © 2026 Kareem Zein</Copyright>
	<PackageProjectUrl>https://github.com/Kareem-Zein/KZ.FileHash</PackageProjectUrl>
	<PackageId>KZ.FileHash</PackageId>
	<AssemblyVersion>1.1.0</AssemblyVersion>
	<FileVersion>1.1.0</FileVersion>
	<NeutralLanguage>en</NeutralLanguage>
	<RepositoryType>git</RepositoryType>
	<EnablePackageValidation>true</EnablePackageValidation>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<PackageReleaseNotes>$([System.IO.File]::ReadAllText("CHANGELOG.md"))</PackageReleaseNotes>
  </PropertyGroup>

	<ItemGroup>
	  <None Include="..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\CHANGELOG.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
